# Supabase Project URL
# Found in: Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (public, safe for client-side)
# Found in: Project Settings → API → Project API Keys → anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Neural TTS Configuration (optional)
# Set the TTS provider: 'device' (default, uses device TTS) or 'neural' (uses Google Cloud TTS)
# EXPO_PUBLIC_TTS_PROVIDER=device

# Google Cloud TTS voice (only used when TTS_PROVIDER=neural)
# Default: en-US-Neural2-F
# See: https://cloud.google.com/text-to-speech/docs/voices
# EXPO_PUBLIC_TTS_VOICE=en-US-Neural2-F

# AI Summaries Configuration (optional)
# OpenAI API key for AI-powered summaries, takeaways, questions, and flashcards
# Get your key at: https://platform.openai.com/api-keys
# Set as a Supabase Edge Function secret:
#   supabase secrets set OPENAI_API_KEY='sk-...'
# Then deploy: supabase functions deploy generate-summary
